---
import { experiences } from '../data/experience.js';
---

<section id="experience" class="section section--soft">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Professional Experience</p>
      <h2>Roles that shaped my software engineering practice.</h2>
    </div>

    <div class="timeline">
      {experiences.map((experience) => (
        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <h3>{experience.role}</h3>
              <span>{experience.period}</span>
            </div>
            <p class="timeline-company">{experience.company}</p>
            {experience.details.length > 0 && (
              <ul>
                {experience.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
