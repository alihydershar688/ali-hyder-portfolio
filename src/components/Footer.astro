---
import { Github, Mail, Linkedin, Copy } from 'lucide-astro';
import { site } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <h3>{site.name}</h3>
      <p>Software Engineer</p>
    </div>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="footer__links">
      <a href={site.github} target="_blank" rel="noreferrer noopener"><Github size={18} /> GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noreferrer noopener"><Linkedin size={18} /> LinkedIn</a>
      <a href={`mailto:${site.email}`}><Mail size={18} /> Email</a>
      <button class="footer-discord-copy" type="button" data-discord-username={site.discordUsername} aria-label={`Copy Discord username ${site.discordUsername}`}>
        <Copy size={18} /> Discord · {site.discordUsername}
      </button>
      <span class="sr-only" data-footer-discord-status aria-live="polite"></span>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<script>
  const discordCopy = document.querySelector('.footer-discord-copy');
  const discordStatus = document.querySelector('[data-footer-discord-status]');

  discordCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(discordCopy.dataset.discordUsername || '');
      discordStatus.textContent = 'Discord username copied.';
    } catch {
      discordStatus.textContent = 'Copy unavailable. Username: freethinker7430';
    }
  });
</script>
