---
import '../styles/global.css';
import { site } from '../data/site.js';
const { pathname } = Astro.url;
const canonical = new URL(pathname, site.portfolio).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={site.description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}/images/og-card.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={`${import.meta.env.BASE_URL}/images/og-card.svg`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{site.title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      const stored = localStorage.getItem('portfolio-theme');
      const initialTheme = stored || 'dark';
      document.documentElement.setAttribute('data-theme', initialTheme);
    </script>
  </body>
</html>
